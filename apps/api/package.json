    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@voicequery/shared": "*",
    "fastify": "^5.12.5",
    "node-sql-parser": "^5.4.0",
    "openai": "^7.25.0",
    "papaparse": "^5.7.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
