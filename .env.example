####################################################################
# VoiceQuery — environment configuration
#
# Copy to `.env` and fill in. Never commit the filled-in file.
# Every value below has a safe default except where marked REQUIRED.
####################################################################

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173


####################################################################
# Application database — PostgreSQL
####################################################################
#
# REQUIRED IN PRODUCTION. If unset in development the server falls back to an
# embedded PGlite instance (real Postgres compiled to WASM) so the project runs
# with no external services. Same dialect, same migrations.
#
# Local Postgres via the bundled compose file:
#   docker compose up -d db
#   DATABASE_URL=postgres://voicequery:voicequery@localhost:5432/voicequery
#
# DATABASE_URL=postgres://user:password@host:5432/voicequery


####################################################################
# Sessions
####################################################################
#
# REQUIRED IN PRODUCTION — the server refuses to boot with the dev default.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-insecure-session-secret-change-me
SESSION_TTL_HOURS=336
# Set to true whenever the site is served over HTTPS.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.com


####################################################################
# AI provider
####################################################################
#
# Three providers are supported: anthropic, openai, openrouter.
# Users can connect their own key for any of them (BYOK); these settings
# are only for the *platform* key, which funds the free credits.
#
# With no key set, the app runs in DEMO MODE: answers come from a local
# rule-based stand-in, labelled "simulated" in the UI. Nothing is presented
# as AI output.
#
# Set exactly one key, or set several and use AI_PROVIDER to pick.
#
# ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com/settings/keys
# OPENAI_API_KEY=sk-...               # platform.openai.com/api-keys
# OPENROUTER_API_KEY=sk-or-v1-...     # openrouter.ai/keys
#
# Required only when more than one key above is set.
# AI_PROVIDER=anthropic
#
# Model for the platform provider.
#   anthropic  — optional, defaults to claude-opus-5
#   openai     — REQUIRED, e.g. gpt-6.1-sol or gpt-6-luna
#   openrouter — REQUIRED, vendor-prefixed, e.g. anthropic/claude-sonnet-4.5
#                Pick one that supports structured outputs; otherwise the
#                adapter falls back to plain JSON mode, which is less reliable.
# AI_MODEL=claude-opus-5

AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4000


####################################################################
# Datasets
####################################################################
DATA_DIR=.data
MAX_UPLOAD_BYTES=10485760
MAX_ROWS=200000
MAX_COLUMNS=60
# Rows delivered to the browser per analysis. Aggregates are always computed
# across the full result set regardless of this cap.
MAX_RESULT_ROWS=500
# Rows of the result the model may see when writing its explanation.
MAX_EXPLAIN_ROWS=40
# Uploaded datasets are deleted automatically after this many hours.
DATASET_TTL_HOURS=24


####################################################################
# Query sandbox
####################################################################
QUERY_TIMEOUT_MS=10000
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=2


####################################################################
# Credits
####################################################################
# Free questions granted once per account, at creation.
FREE_CREDITS=2

# Whether demo mode (no ANTHROPIC_API_KEY) consumes credits.
#
# Default false: demo mode makes no provider call and spends nothing, so
# charging an AI credit for it would misrepresent what happened. Its real cost
# is hosting and CPU, which the rate limits below cover — the same reasoning
# that exempts BYOK.
#
# Set true to walk through the free-allowance and upgrade-modal flows on a
# deployment with no AI credentials (useful when recording a demo).
# DEMO_CONSUMES_CREDITS=false


####################################################################
# Guest mode (try the demo without signing in)
####################################################################
#
# Anonymous visitors get a guest session: the sample dataset only, always
# served by the offline demo provider, never a paid one. That last part is
# the cost boundary — without it, anonymous traffic could spend your AI
# budget. Guests cannot upload, connect a key, or buy credits.
#
GUEST_MODE_ENABLED=true
# Answers before the first "sign up for real answers" nudge...
GUEST_NUDGE_AFTER=2
# ...and how often it repeats after that. The nudge is dismissible.
GUEST_NUDGE_EVERY=3
# Hard ceiling per guest session. This one is NOT dismissible — it is the
# abuse control, separate from the nudge.
GUEST_QUESTION_LIMIT=15
# Guest accounts and their conversations are deleted after this long.
GUEST_TTL_HOURS=24


####################################################################
# Payments (Stripe) — optional
####################################################################
#
# Billing stays disabled until STRIPE_SECRET_KEY and CREDIT_PACKAGES are both
# set. Keys beginning sk_test_ put the UI into a clearly-labelled test mode.
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...       # from `stripe listen` or the dashboard
#
# Package prices are deliberately NOT hardcoded anywhere in the source. Set
# them from your own measured model, hosting, database and payment costs.
# The figures below are placeholders — replace before taking real payments.
#
# CREDIT_PACKAGES=[{"id":"pack20","name":"20 questions","credits":20,"amountMinor":900,"currency":"usd"}]

CHECKOUT_SUCCESS_URL=http://localhost:5173/app?checkout=success
CHECKOUT_CANCEL_URL=http://localhost:5173/app?checkout=cancelled


####################################################################
# Rate limits
####################################################################
RATE_LIMIT_ANALYSIS_PER_HOUR=60
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_GLOBAL_PER_MINUTE=300


####################################################################
# Frontend (apps/web) — Vite build-time only
####################################################################
# Leave unset for same-origin deployment or the dev proxy.
# VITE_API_BASE=https://api.yourdomain.com
# Dev-only: where the Vite proxy forwards /api.
# VITE_API_TARGET=http://localhost:8787
